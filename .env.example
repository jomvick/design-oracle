# Redis (required for job queue + SSE pub/sub)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend → API proxy (Next.js rewrites)
API_URL=http://localhost:5000

# MCP server → API base URL
DESIGN_ORACLE_URL=http://localhost:5000

# Uvicorn hot-reload in local dev (set to 0 in production)
UVICORN_RELOAD=1

# API key for /api/maintenance/cleanup endpoint
MAINTENANCE_API_KEY=your-maintenance-api-key-here

# Allow resolving/navigating to private/local IP ranges in development (default false in production)
ALLOW_PRIVATE_IPS=false

# Stealth mode: inject JS evasions to bypass basic bot protection (default false)
STEALTH_MODE=false

# Analysis timeouts (must hold: TIMEOUT_SECONDS < ARQ_JOB_TIMEOUT_SECONDS)
TIMEOUT_SECONDS=30
ARQ_JOB_TIMEOUT_SECONDS=180

# MCP transport: stdio (default) or sse (exposed at http://localhost:5000/mcp)
DESIGN_ORACLE_TRANSPORT=stdio

